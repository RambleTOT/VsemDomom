        "selector": "JSXOpeningElement[name.name='CellSimple'] > JSXAttribute[name.name='height'] > Literal[value!=/^(?:compact|normal)$/]",
        "message": "<CellSimple> height must be one of 'compact' | 'normal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellSimple'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:default|island)$/]",
        "message": "<CellSimple> surface must be one of 'default' | 'island'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClearableInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:withClearButton|count|innerClassNames|key|ref|className|style|children)$/]",
        "message": "<ClearableInput> doesn't accept that prop. Declared props: withClearButton, count, innerClassNames."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:fullWidth|as|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: fullWidth, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|variant|rounded|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: value, variant, rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|primary-contrast|attention|attention-contrast|promo|static|static-contrast|default|mute|menu)$/]",
        "message": "<Counter> variant must be one of 'primary' | 'primary-contrast' | 'attention' | 'attention-contrast' | 'promo' | 'static' | 'static-contrast' | 'default' | 'mute' | 'menu'."
      },
