      {
        "selector": "JSXOpeningElement[name.name='CellInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|height|surface|key|ref|className|style|children)$/]",
        "message": "<CellInput> doesn't accept that prop. Declared props: before, height, surface."
      },
