        "message": "<CellInput> height must be one of 'compact' | 'normal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellInput'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:default|island)$/]",
        "message": "<CellInput> surface must be one of 'default' | 'island'."
      },
