{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/avatar/**",
              "components/buttons/**",
              "components/cells/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/typography/**",
              "components/utility/**",
              "ui_kits/mini-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarContainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|form|onlineStatus|overlay|rightTopCorner|rightBottomCorner|key|ref|className|style|children)$/]",
        "message": "<AvatarContainer> doesn't accept that prop. Declared props: size, form, onlineStatus, overlay, rightTopCorner, rightBottomCorner."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarContainer'] > JSXAttribute[name.name='form'] > Literal[value!=/^(?:circle|squircle)$/]",
        "message": "<AvatarContainer> form must be one of 'circle' | 'squircle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|stretched|iconBefore|iconAfter|indicator|loading|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: size, variant, stretched, iconBefore, iconAfter, indicator, loading, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xsmall|small|medium|large)$/]",
        "message": "<Button> size must be one of 'xsmall' | 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|primary-contrast|secondary-contrast|overlay|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'primary-contrast' | 'secondary-contrast' | 'overlay' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|surface|height|before|showChevron|key|ref|className|style|children)$/]",
        "message": "<CellAction> doesn't accept that prop. Declared props: mode, surface, height, before, showChevron."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellAction'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:primary|secondary|themed|destructive|custom)$/]",
        "message": "<CellAction> mode must be one of 'primary' | 'secondary' | 'themed' | 'destructive' | 'custom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellAction'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:default|island)$/]",
        "message": "<CellAction> surface must be one of 'default' | 'island'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellAction'] > JSXAttribute[name.name='height'] > Literal[value!=/^(?:compact|normal)$/]",
        "message": "<CellAction> height must be one of 'compact' | 'normal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:titleStyle|fullWidth|after|key|ref|className|style|children)$/]",
        "message": "<CellHeader> doesn't accept that prop. Declared props: titleStyle, fullWidth, after."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellHeader'] > JSXAttribute[name.name='titleStyle'] > Literal[value!=/^(?:caps|normal)$/]",
        "message": "<CellHeader> titleStyle must be one of 'caps' | 'normal'."
