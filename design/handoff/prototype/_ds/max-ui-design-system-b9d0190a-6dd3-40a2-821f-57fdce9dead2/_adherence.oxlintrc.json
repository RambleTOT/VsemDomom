        "message": "<CellList> mode must be one of 'full-width' | 'island'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CellSimple'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|subtitleMode|overline|before|after|showChevron|height|surface|disabled|separator|link|as|key|ref|className|style|children)$/]",
