{
  "name": "vsemdomom",
  "version": "0.1.0",
  "private": true,
  "description": "«Всем домом» — бот и мини-приложение для домового чата MAX",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @vsemdomom/miniapp lint && pnpm depcruise",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "test": "vitest run",
    "e2e:scenario": "pnpm --filter @vsemdomom/api e2e:scenario",
    "e2e:load": "pnpm --filter @vsemdomom/api e2e:load",
    "examples": "pnpm --filter @vsemdomom/api examples",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "docker compose up --build",
    "db:generate": "pnpm --filter @vsemdomom/api db:generate",
    "db:migrate": "pnpm --filter @vsemdomom/api db:migrate",
    "openapi:gen": "pnpm --filter @vsemdomom/shared openapi:gen",
    "openapi:check": "pnpm --filter @vsemdomom/shared openapi:check",
    "data-api:run": "pnpm --filter @vsemdomom/api data-api:run",
    "gen:max-types": "pnpm --filter @vsemdomom/api gen:max-types",
    "license-check": "license-checker-rseidelsohn --start apps/api --excludePrivatePackages --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;BlueOak-1.0.0;Python-2.0\" && license-checker-rseidelsohn --start apps/miniapp --excludePrivatePackages --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;BlueOak-1.0.0;Python-2.0\"",
    "max:me": "pnpm --filter @vsemdomom/api max:me",
    "max:subscribe": "pnpm --filter @vsemdomom/api max:subscribe",
    "max:unsubscribe": "pnpm --filter @vsemdomom/api max:unsubscribe",
    "max:subscriptions": "pnpm --filter @vsemdomom/api max:subscriptions",
    "max:commands": "pnpm --filter @vsemdomom/api max:commands"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
