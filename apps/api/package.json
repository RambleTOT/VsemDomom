{
  "name": "@vsemdomom/api",
  "version": "0.1.0",
  "private": true,
  "description": "API, webhook и worker «Всем домом»",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --conditions=source --watch src/main.ts",
    "dev:worker": "node --conditions=source --watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=source src/migrate.ts",
    "gen:max-types": "openapi-typescript src/max/schema.yaml -o src/max/schema.gen.ts --default-non-nullable false"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@vsemdomom/core": "workspace:*",
    "@vsemdomom/shared": "workspace:*",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "nanoid": "6.0.1",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "openapi-typescript": "7.13.0"
  }
}
