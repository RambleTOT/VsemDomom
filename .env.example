# «Всем домом» — переменные окружения.
# Для локального запуска файл .env не обязателен: compose.yaml подставляет эти же значения по умолчанию.
# Свои значения: cp .env.example .env и правка. Файл .env в Git не коммитится.
# Значения с пометкой «только локально» — тестовые; сервис откажется стартовать с ними при NODE_ENV=production.

# --- Режим ---
NODE_ENV=development
APP_NAME=Всем домом
# Хост для Caddy на стенде (infra/compose.prod.yaml)
DOMAIN=
# Внешний адрес: webhook и мини-приложение. На стенде — https://app.<домен>
PUBLIC_BASE_URL=http://localhost:8080

# --- MAX ---
# simulator — без токена (локально и в тестах); polling — только с отдельным dev-ботом; webhook — боевой стенд.
# Не запускайте локально с боевым токеном в режиме webhook: это перепишет подписку боевого бота.
MAX_MODE=simulator
MAX_API_BASE=https://platform-api2.max.ru
# Лимиты запросов к MAX: общий (документация — 30 rps, держим запас), отправка и правка
# сообщений в один чат, ответы на нажатия в один чат (0 — без лимита по чату)
MAX_RATE_GLOBAL_RPS=25
MAX_RATE_PER_CHAT=2
MAX_RATE_ANSWERS_PER_CHAT=2
# Секрет. Только в .env на сервере.
MAX_BOT_TOKEN=
# Публичное имя бота для диплинков и кнопок open_app
MAX_BOT_USERNAME=
# Секрет, 5–256 символов A-Za-z0-9_-: openssl rand -hex 32
MAX_WEBHOOK_SECRET=

# --- Сессии и вход ---
# Только локально. На стенде: openssl rand -hex 32
SESSION_SECRET=local-only-session-secret-change-me-0123456789
INITDATA_MAX_AGE_SEC=3600
# Вход в мини-приложение вне MAX (http://localhost:8080/?dev_user=1001&dev_role=resident). На стенде — false.
DEV_AUTH=true

# --- База данных ---
# compose.yaml собирает адрес сам: postgres://app:${POSTGRES_PASSWORD}@db:5432/app
DATABASE_URL=
# Только локально. На стенде: openssl rand -hex 24
POSTGRES_PASSWORD=app

# --- Демо и проверка ---
DEMO_MODE=true
# Только локально. На стенде — свой код (он же на служебном слайде).
DEMO_UK_CODE=DEMO-UK-LOCAL
CHECKER_API_ENABLED=true
# Только локально. На стенде: openssl rand -hex 24
CHECKER_TOKEN_RESIDENT=local-only-checker-resident-token-01
CHECKER_TOKEN_RESIDENT_2=local-only-checker-resident-token-02
CHECKER_TOKEN_UK=local-only-checker-uk-token-000000001
# MAX ID сотрудников модельной УК (команда), через запятую
SEED_UK_STAFF_MAX_IDS=
# Кому бот шлёт алерты (MAX user id)
ALERT_USER_ID=

# --- Параметры сценария ---
QUIET_HOURS=22:00-08:00
CHECK_WINDOW_MIN=360
DEMO_CHECK_WINDOW_MIN=5
DISCREPANCY_MAX_HOURS=72
DEMO_NEIGHBOUR_ANSWER_DELAY_SEC=60
WATER_QUALITY_POLL_DELAY_HOURS=3

# --- Флаги функций волн 2–3 ---
FEATURE_KEYWORD_REPLY=false
FEATURE_BRIGADE_CONFIRM=true
FEATURE_TRUST_LEVELS=true
FEATURE_JOIN_CHAT=true
FEATURE_POLLS=true
FEATURE_MONTHLY_SUMMARY=true
FEATURE_ACT_TEMPLATE=true

# --- Эксплуатация ---
LOG_LEVEL=info
HTTP_PORT=3000
# Порт Caddy локально
WEB_PORT=8080
# Подставляется при сборке: GIT_COMMIT=$(git rev-parse --short HEAD) docker compose up --build
GIT_COMMIT=
